# Canonical production domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://finvalio.com

# Google AdSense Publisher ID (e.g., ca-pub-1234567890123456)
# Leave empty until your AdSense account is approved and ready.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Individual AdSense Slot IDs (create responsive display units in AdSense dashboard)
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=

# Optional Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
